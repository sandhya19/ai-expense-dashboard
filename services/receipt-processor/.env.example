APP_ENV=local
APP_VERSION=0.1.0
LOG_LEVEL=INFO

RECEIPT_PROCESSOR_API_KEY=replace-with-internal-token-if-needed
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_JWT_SECRET=replace-with-supabase-jwt-secret
SUPABASE_RECEIPTS_BUCKET=receipts
SUPABASE_RECEIPTS_TABLE=receipts
SUPABASE_RECEIPT_ITEMS_TABLE=receipt_items

OCR_PROVIDER=mock
OCR_TIMEOUT_SECONDS=20
OCR_MAX_RETRIES=2

EMBEDDING_PROVIDER=mock
MAX_UPLOAD_BYTES=10485760
REPOSITORY_BACKEND=memory
STORAGE_BACKEND=memory

